[0.5, "o", "\u001b[0;36mpharos-security-scan — security guard for Pharos Agents\u001b[0m\r\n"]
[1.1, "o", "\u001b[0;36mBefore an Agent trusts an address, it asks: is this SAFE?\u001b[0m\r\n"]
