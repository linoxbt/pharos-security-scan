{
  "name": "pharos-security-scan",
  "version": "1.0.0",
  "description": "Reusable Pharos Skill for multi-layer EVM address security scanning using GoPlus Security APIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pharos-security-scan": "dist/index.js",
    "pharos-onchain-memo": "dist/memo.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "skills",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linoxbt/pharos-security-scan.git"
  },
  "homepage": "https://github.com/linoxbt/pharos-security-scan#readme",
  "bugs": {
    "url": "https://github.com/linoxbt/pharos-security-scan/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "scan": "ts-node src/index.ts",
    "memo": "ts-node src/memo.ts",
    "demo": "bash examples/demo.sh",
    "demo:cast": "python3 examples/gen-cast.py > examples/demo.cast",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pharos",
    "skill",
    "security",
    "goplus",
    "web3",
    "agent",
    "defi",
    "blockchain"
  ],
  "author": "linoxbt",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
