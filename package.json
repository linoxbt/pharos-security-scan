{
  "name": "pharos-security-scan",
  "version": "1.0.0",
  "description": "Reusable Pharos Skill for multi-layer EVM address security scanning using GoPlus Security APIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
